<%- include('partials/head') %>
    <%- include('partials/navbar') %>

        <main class="container mt-5">
            <section>
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <h2 class="mb-4">สมัครสมาชิก</h2>
                        <% if (typeof message !=='undefined' && message !==null) { %>
                            <div class="alert alert-<%= messageType %>">
                                <%= message %>
                                </div>
                                    <% } %>
                                        <form action="/register" method="POST" class="card p-4 shadow-sm">

                                            <!-- ชื่อผู้ใช้งาน -->
                                            <label for="username">ชื่อผู้ใช้งาน</label>
                                            <input type="text" name="username" placeholder="ชื่อผู้ใช้งาน"
                                                class="form-control mb-3">

                                            <!-- อีเมล -->
                                            <label for="email">อีเมล</label>
                                            <input type="email" name="email" placeholder="กรุณาใส่อีเมลที่ถูกต้อง"
                                                class="form-control mb-3">

                                            <!-- รหัสผ่าน -->
                                            <label for="password">รหัสผ่าน</label>
                                            <input type="password" name="password"
                                                placeholder="กรุณาใส่รหัสผ่านมากกว่า 6 ตัวอักษร "
                                                class="form-control mb-3">

                                            <button type="submit" class="btn btn-primary">
                                                ลงทะเบียน
                                            </button>

                                        </form>
                            
                    </div>

                </div>

            </section>


        </main>








        <%- include('partials/footer') %>